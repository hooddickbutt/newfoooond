# Public project settings. These override src/config/project.ts when set.
# They are visible in the browser. Do not put private keys here.

NEXT_PUBLIC_CONTRACT_ADDRESS=YOUR_CONTRACT_ADDRESS
NEXT_PUBLIC_NETWORK=YOUR_NETWORK
NEXT_PUBLIC_TOTAL_SUPPLY=YOUR_TOTAL_SUPPLY
NEXT_PUBLIC_TRADE_URL=YOUR_TRADE_URL
NEXT_PUBLIC_X_URL=YOUR_X_URL
NEXT_PUBLIC_COMMUNITY_URL=YOUR_COMMUNITY_URL
NEXT_PUBLIC_SITE_URL=http://localhost:43123

# Server-only. Never prefix these with NEXT_PUBLIC.

# Optional joke model. Leave unset to use the local response library.
# OpenAI-compatible: set all three. The URL is the full chat-completions endpoint.
# Custom endpoint: set only NOBRAIN_AI_API_URL. POST { "question": "..." } and return { "text": "..." }.
NOBRAIN_AI_API_URL=
NOBRAIN_AI_API_KEY=
NOBRAIN_AI_MODEL=

# Optional market source. Leave unset to show DATA CONNECTION OFFLINE.
# GET this URL with Authorization: Bearer BLOCKCHAIN_API_KEY when the key is set.
# Expected JSON:
# {
#   "price": "0.00",
#   "marketCap": "0",
#   "liquidity": "0",
#   "volume24h": "0",
#   "holders": "0",
#   "transactions": [
#     { "id": "tx1", "type": "buy", "wallet": "0xabc", "amount": "1", "timestamp": "2026-01-01T00:00:00Z" }
#   ]
# }
# type must be "buy", "sell", or "wallet".
BLOCKCHAIN_API_URL=
BLOCKCHAIN_API_KEY=

# Optional community feed. Leave unset to show labeled sample memes.
# Expected JSON: { "posts": [ { "id", "top", "bottom", "expression", "template", "demo" } ] }
COMMUNITY_API_URL=
COMMUNITY_API_KEY=
